# Database
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5544/document_pipeline

# Redis
REDIS_URL=redis://localhost:6380/0
JOB_INGESTION_CHANNEL=jobs.ingest

# Celery
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
CELERY_MAX_RETRIES=5
CELERY_RETRY_BACKOFF_BASE_SECONDS=2

# Document Processing
MAX_FILE_SIZE_MB=500
SUPPORTED_FORMATS=pdf,image,video

# Recovery scheduler
STUCK_JOB_THRESHOLD_MINUTES=15
RECOVERY_SCAN_INTERVAL_SECONDS=300

# LLM
LLM_PROVIDER=openrouter
LLM_API_KEY=your-api-key
LLM_MODEL=openrouter/auto

# Server
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
