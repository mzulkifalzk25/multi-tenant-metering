{
  "name": "multi-tenant-metering",
  "version": "1.0.0",
  "description": "Hierarchical quota system with immutable audit ledger",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "test": "node --test --import tsx src/tests/*.test.ts",
    "test:watch": "node --test --watch --import tsx src/tests/*.test.ts",
    "test:integration": "node --test --import tsx src/tests/integration.test.ts",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:up": "docker compose up -d postgres",
    "start": "node dist/index.js"
  },
  "keywords": [
    "quota",
    "metering",
    "multi-tenant"
  ],
  "author": "Muhammad Zulkifal Qayyum",
  "license": "MIT",
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-http": "^8.6.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "drizzle-kit": "^0.20.18",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
